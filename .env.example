# Copy to .env and fill in real values. .env is gitignored.

# --- Warehouse (Postgres in docker-compose.yml) ---
# Host port; 55432 avoids clashing with any other local Postgres (including Switch's).
WAREHOUSE_PORT=55432
WAREHOUSE_DB=datatrace
# Superuser: used only for setup/seeding, never given to agents.
WAREHOUSE_ADMIN_USER=datatrace_admin
WAREHOUSE_ADMIN_PASSWORD=change-me

# Least-privilege logins (created by database/setup.sh)
AGENT_SOURCE_PASSWORD=change-me
AGENT_PIPELINE_PASSWORD=change-me
AGENT_METRICS_PASSWORD=change-me
DBT_RUNNER_PASSWORD=change-me
